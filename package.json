{
  "name": "problem2-learning-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "题2《AI 学习辅助网页》— 零第三方依赖的 TypeScript 实现（CLI 演示 + 本地网页加分项）",
  "type": "module",
  "scripts": {
    "demo": "node --experimental-strip-types demo/l1-demo.ts",
