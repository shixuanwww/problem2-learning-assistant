{
  "name": "problem2-learning-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "题2《AI 学习辅助网页》— 零第三方运行时依赖的 TypeScript 实现（CLI 演示 + 本地网页）",
  "type": "module",
  "scripts": {
    "demo": "node --experimental-strip-types demo/l1-demo.ts",
    "demo:full": "node --experimental-strip-types demo/full-demo.ts",
    "demo:persist": "node --experimental-strip-types demo/verify-persist.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "serve": "node --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types demo/l1-demo.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
